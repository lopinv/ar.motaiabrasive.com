---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { industries, productCategories } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const recommended = productCategories.filter((product) => (industry.products as readonly string[]).includes(product.slug));
const breadcrumbs = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الصناعات', href: '/industries' },
  { name: industry.name, href: `/industries/${industry.slug}` },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: industry.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${industry.title} | حلول موتاى الصناعية`}
  description={`حلول الصنفرة ${industry.name} من موتاى: تحديات التشغيل، المنتجات الموصى بها، خطوات اختيار المواصفة، ومعلومات تجهيز طلب التسعير.`}
  image={industry.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-hero page-hero--image">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">حلول قطاع {industry.name}</span>
      <h1>{industry.title}</h1>
      <p>{industry.description}</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container solution-layout">
      <div class="solution-main">
        <div class="content-block">
          <span class="eyebrow">تحديات التشغيل</span>
          <h2>ما الذي يجعل اختيار المواد صعبًا في هذا القطاع؟</h2>
          <p>
            جودة المنتج النهائي تعتمد على اتساق عملية الصنفرة من البداية حتى اللمسة الأخيرة.
            لذلك لا نكتفي بإرسال أداة عامة؛ نراجع تحدي التشغيل، ثم نربطه بمادة كاشطة وشكل أداة
            ودرجة مناسبة.
          </p>
          <div class="challenge-list">
            {
              industry.challenges.map((challenge, index) => (
                <div><span>0{index + 1}</span><p>{challenge}</p></div>
              ))
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">خطة الاختيار</span>
          <h2>كيف نحدد المواصفة المناسبة؟</h2>
          <ol class="selection-steps">
            <li><strong>حدد سطح العمل</strong><p>نعرف نوع الخشب أو المعدن، وحالة السطح، والبقايا أو عيوب التشغيل.</p></li>
            <li><strong>راجع طريقة التشغيل</strong><p>نراجع طراز الماكينة، وطريقة التثبيت، والضغط وسرعة السحب.</p></li>
            <li><strong>اختر مادة ودرجة</strong><p>نحدد نوع الحبيبات والدرجة التي تطابق مرحلة الإزالة أو التشطيب.</p></li>
            <li><strong>اختبر العينة</strong><p>يمكن إرسال عينة أو تجربة مواصفة قبل اعتماد الكمية التجارية.</p></li>
          </ol>
        </div>

        <div class="content-block">
          <span class="eyebrow">الأسئلة الشائعة</span>
          <h2>أسئلة عن تشغيل {industry.name}</h2>
          <div class="faq-list">
            {industry.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="solution-sidebar">
        <StickyQuote application={industry.name} />
        <div class="sidebar-card">
          <h3>المنتجات الموصى بها</h3>
          <ul class="sidebar-products">
            {
              recommended.map((product) => (
                <li>
                  <a href={`/products/${product.slug}`}>
                    <img src={product.image} alt="" width="72" height="54" loading="lazy" />
                    <span><strong>{product.name}</strong><small>عرض المواصفات ←</small></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="sidebar-card sidebar-card--soft">
          <h3>قبل طلب العرض</h3>
          <p>أرسل نوع مادة العمل، والماكينة، والمقاس المطلوب، والكمية ووجهة الشحن.</p>
          <a class="text-link" href="/resources/abrasive-grit-guide">دليل اختيار الحبيبات <span>←</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">حلول قطاعات أخرى</span>
          <h2>استعرض حلول القطاعات الأخرى</h2>
        </div>
        <a class="button button--outline" href="/industries">كل الحلول</a>
      </div>
      <div class="related-grid">
        {
          industries
            .filter((item) => item.slug !== industry.slug)
            .map((item) => (
              <a class="related-card" href={`/industries/${item.slug}`}>
                <img src={item.image} alt="" width="320" height="220" loading="lazy" />
                <div><h3>{item.name}</h3><p>{item.description}</p><span>استعرض الحل ←</span></div>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles industry={industry.slug} />
    </div>
  </section>

  <CtaBand
    title={`طوّر حل صنفرة لـ ${industry.name}`}
    text="اشرح لنا جزء التشغيل الذي يعاني من المشكلة. نراجع المواصفة ونقترح المواد والاختبار المناسب."
  />
</Layout>
