---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { productCategories } from '../../data/site';
import { getModelByCategory } from '../../data/models';

export function getStaticPaths() {
  return productCategories.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = productCategories.filter((item) => item.slug !== product.slug).slice(0, 3);
const categoryModels = getModelByCategory(product.slug);
const breadcrumbs = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المنتجات', href: '/products' },
  { name: product.name, href: `/products/${product.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: new URL(product.image, Astro.site).href,
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: 'Abrasive Products',
  additionalProperty: product.specs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${product.name} | مواصفات وتوريد من موتاى`}
  description={`${product.name} من موتاى: الاستخدامات، المواصفات المرجعية، الخيارات المتاحة، وأسئلة المشترين لاختيار المنتج الأنسب لطلبك.`}
  image={product.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">مجموعة منتجات موتاى</span>
        <h1>{product.title}</h1>
        <p>{product.description}</p>
        <ul class="hero__trust">
          <li>مواصفة تتأكد قبل الإنتاج</li>
          <li>دعم عينات حسب الطلب</li>
          <li>خيارات OEM</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${product.slug}`}>اطلب عرض سعر</a>
          <a class="button button--ghost" href="#specs">راجع المواصفات</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={product.image} alt={`${product.name} من مصنع موتاى`} width="680" height="510" />
        <figcaption>يمكن توريد المنتج ضمن عبوات تجارية أو بعلامات خاصة بعد تأكيد المواصفة.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">متى تستخدم هذا المنتج؟</span>
          <h2>مناسب لتطبيقات التشطيب والتشطيب</h2>
          <p>
            {product.name} يخدم المشروعات التي تحتاج إلى نتيجة قابلة للتكرار في مرحلة التشطيب.
            يبدأ اختيار المنتج من تحديد مادة العمل والماكينة والدرجة المطلوبة، ثم نضبط المواصفة
            بما يناسب طريقة التشغيل والكمية المتوقعة.
          </p>
          <ul class="check-list check-list--large">
            <li>اختيار الشكل والمقاس بما يطابق الماكينة وطريقة التثبيت.</li>
            <li>تحديد درجة الحبيبات أو الخامة حسب مرحلة الإزالة والتشطيب.</li>
            <li>مراجعة نوع القاعدة والتوافق مع معدات المشتري.</li>
            <li>اعتماد الكمية والتغليف قبل تحويل أمر الإنتاج.</li>
          </ul>
        </div>

        <div class="content-block" id="specs">
          <span class="eyebrow">المواصفات المرجعية</span>
          <h2>معلومات فنية تساعد على تجهيز طلب التسعير</h2>
          <div class="table-wrap">
            <table>
              <caption>المواصفات العامة لـ {product.name}. تُراجع المواصفة النهائية مع المشتري.</caption>
              <thead><tr><th>البند</th><th>الوصف</th></tr></thead>
              <tbody>
                {product.specs.map(([name, value]) => <tr><th scope="row">{name}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            تختلف المتطلبات النهائية حسب التطبيق والماكينة والكمية. تواصل معنا لتأكيد المواصفة
            الدقيقة والتوافر قبل اعتماد الكمية.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">المقاسات المتوفرة</span>
          <h2>اختر المقاس الذي يتوافق مع ماكينتك</h2>
          <p>
            كل مقاس يوضّح درجات الحبيبات المتاحة ونوع القاعدة وطريقة التثبيت، لتتمكن من تجهيز
            طلب التسعير دون التخمين.
          </p>
          <div class="model-list">
            {
              categoryModels.length ? (
                categoryModels.map((model) => (
                  <a class="model-list__item" href={`/products/models/${model.slug}`}>
                    <img src={model.image} alt="" width="96" height="72" loading="lazy" />
                    <span>
                      <strong>{model.name}</strong>
                      <small>{model.gritRange.length} درجة حبيبات · {model.backing}</small>
                    </span>
                    <span class="model-list__arrow">←</span>
                  </a>
                ))
              ) : (
                <p class="model-list__empty">
                  تتوفر هذه المجموعة حسب المواصفة المطلوبة — أرسل المقاس والدرجة التي تناسب
                  ماكينتك عبر عرض السعر، ونؤكد التوفر قبل الإنتاج.
                </p>
              )
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">الأسئلة الشائعة</span>
          <h2>أسئلة يطرحها مشتري المواد الكاشطة</h2>
          <div class="faq-list">
            {product.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={product.name} />
        <div class="sidebar-card">
          <h3>معلومات مفيدة للطلب</h3>
          <ul class="check-list">
            <li>نوع المنتج والمقاس أو القطر</li>
            <li>الدرجة أو نوع الحبيبات</li>
            <li>الماكينة وطريقة التثبيت</li>
            <li>الكمية ووجهة الشحن</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">راجع دليل الحبيبات <span>←</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">منتجات ذات صلة</span>
          <h2>قد تكون هذه المنتجات مناسبة لطلبك</h2>
        </div>
        <a class="button button--outline" href="/products">عرض جميع المنتجات</a>
      </div>
      <div class="related-grid">
        {
          related.map((item) => (
            <a class="related-card" href={`/products/${item.slug}`}>
              <img src={item.image} alt="" width="320" height="220" loading="lazy" />
              <div><h3>{item.name}</h3><p>{item.description}</p><span>استعرض المنتج ←</span></div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={product.slug} />
    </div>
  </section>

  <CtaBand
    title={`هل تحتاج عرض سعر لـ ${product.name}؟`}
    text="أرسل المقاس والكمية ونوع التطبيق. نراجع المواصفة ونجهز لك عرضًا واضحًا."
  />
</Layout>
