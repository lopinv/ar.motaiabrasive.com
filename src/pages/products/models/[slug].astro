---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import FaqItem from '../../../components/FaqItem.astro';
import StickyQuote from '../../../components/StickyQuote.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import { models } from '../../../data/models';
import { productCategories } from '../../../data/site';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const category = productCategories.find((item) => item.slug === model.categorySlug)!;
const siblings = models.filter((item) => item.categorySlug === model.categorySlug && item.slug !== model.slug);
const breadcrumbs = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المنتجات', href: '/products' },
  { name: category.name, href: `/products/${category.slug}` },
  { name: model.sizeLabel, href: `/products/models/${model.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: model.name,
  description: model.summary,
  image: new URL(model.image, Astro.site).href,
  sku: model.slug.toUpperCase(),
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: model.family,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'المقاس', value: model.sizeAr },
    { '@type': 'PropertyValue', name: 'درجات الحبيبات', value: model.gritRange.join('، ') },
    { '@type': 'PropertyValue', name: 'نوع القاعدة', value: model.backing },
    { '@type': 'PropertyValue', name: 'طريقة التثبيت', value: model.attachment },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: model.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${model.name} | موتاى للمواد الكاشطة`}
  description={`${model.name} من موتاى: ${model.gritRange.length} درجة حبيبات متاحة، مواصفات واضحة ومواد صنفرة بالجملة. اطلب عرض سعر لمقاسك ودرجتك.`}
  image={model.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">{model.family} · موتاى</span>
        <h1>{model.name}</h1>
        <p>{model.summary}</p>
        <ul class="hero__trust">
          <li>{model.gritRange.length} درجة حبيبات</li>
          <li>مواصفة تتأكد قبل الإنتاج</li>
          <li>توريد بالجملة</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${model.slug}`}>اطلب عرض سعر</a>
          <a class="button button--ghost" href="#grit">راجع درجات الحبيبات</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={model.image} alt={model.imageAlt} width="680" height="510" />
        <figcaption>الحد الأدنى للكمية والشروط التجارية تُؤكد ضمن عرض السعر.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">متى يكون هذا المقاس مناسبًا؟</span>
          <h2>مقاس محدد، ومخزون من الدرجات يغطي دورة التشطيب</h2>
          <p>
            {model.summary} اختيار المقاس الصحيح يبدأ من مطابقة طراز الماكينة وطريقة التثبيت، ثم
            نحدد الدرجة بحسب طبيعة مادة العمل ونتيجة التشطيب المطلوبة.
          </p>
          <ul class="check-list check-list--large">
            <li>المقاس: <strong>{model.sizeAr}</strong></li>
            <li>نوع القاعدة: {model.backing}</li>
            <li>طريقة التثبيت: {model.attachment}</li>
          </ul>
        </div>

        <div class="content-block" id="grit">
          <span class="eyebrow">درجات الحبيبات</span>
          <h2>ما الدرجة التي تناسب مرحلتك؟</h2>
          <p>
            نعرض {model.gritRange.length} درجة متاحة لهذا المقاس. الاختيار الدقيق يعتمد على
            مادة العمل والضغط ومعدل التغذية، لذلك نرسل عينة عند الحاجة قبل اعتماد الكمية.
          </p>
          <ul class="grit-grid" aria-label="درجات الحبيبات المتاحة">
            {model.gritRange.map((grit) => <li>{grit}</li>)}
          </ul>
          <div class="table-wrap">
            <table>
              <caption>ملخص المواصفة المرجعية لـ {model.name}. تُراجع المواصفة النهائية مع المشتري.</caption>
              <thead><tr><th>البند</th><th>الوصف</th></tr></thead>
              <tbody>
                <tr><th scope="row">المقاس</th><td>{model.sizeAr}</td></tr>
                <tr><th scope="row">درجات الحبيبات</th><td>{model.gritRange.join('، ')}</td></tr>
                <tr><th scope="row">نوع القاعدة</th><td>{model.backing}</td></tr>
                <tr><th scope="row">طريقة التثبيت</th><td>{model.attachment}</td></tr>
                <tr><th scope="row">مجموعة المنتج</th><td>{model.family}</td></tr>
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            الأسعار تعتمد على الدرجة والكمية والتغليف ووجهة الشحن. تُرسل المواصفة التفصيلية
            والتكلفة ضمن عرض السعر.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">نقاط يجب مراعاتها</span>
          <h2>ثلاثة أمور تحسم نجاح التوريد</h2>
          <ol class="selection-steps">
            {model.notes.map((note) => <li><p>{note}</p></li>)}
          </ol>
        </div>

        <div class="content-block">
          <span class="eyebrow">الأسئلة الشائعة</span>
          <h2>أسئلة عن {model.name}</h2>
          <div class="faq-list">
            {model.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={model.name} />
        <div class="sidebar-card">
          <h3>معلومات مفيدة للطلب</h3>
          <ul class="check-list">
            <li>المقاس: {model.sizeAr}</li>
            <li>الدرجة المطلوبة</li>
            <li>الكمية وتكرار الطلب</li>
            <li>وجهة الشحن</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">راجع دليل الحبيبات <span>←</span></a>
        </div>
        {
          siblings.length > 0 && (
            <div class="sidebar-card sidebar-card--soft">
              <h3>مقاسات أخرى في نفس المجموعة</h3>
              <ul class="plain-links">
                {siblings.map((item) => (
                  <li><a href={`/products/models/${item.slug}`}>{item.name} ←</a></li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">سياق الشراء</span>
          <h2>قارن المقاسات قبل اعتماد الطلب</h2>
        </div>
        <a class="button button--outline" href={`/products/${category.slug}`}>صفحة {category.name}</a>
      </div>
      <div class="related-grid">
        <a class="related-card" href={`/products/${category.slug}`}>
          <img src={category.image} alt="" width="320" height="220" loading="lazy" />
          <div>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
            <span>راجع كتالوج المجموعة ←</span>
          </div>
        </a>
        <a class="related-card" href="/resources/abrasive-grit-guide">
          <img src="/images/grit-reference.png" alt="" width="320" height="220" loading="lazy" />
          <div><h3>دليل اختيار درجات الحبيبات</h3><p>جدول مرجعي يربط الدرجة بمهمة التشطيب الأساسية.</p><span>اقرأ الدليل ←</span></div>
        </a>
        <a class="related-card" href="/quality">
          <img src="/images/converting.jpg" alt="" width="320" height="220" loading="lazy" />
          <div><h3>ضمان الجودة</h3><p>مراحل تأكيد المواصفة وفحص العينة قبل تحويل أمر الإنتاج.</p><span>تعرّف على الفحص ←</span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={model.categorySlug} />
    </div>
  </section>

  <CtaBand
    title={`اطلب عرض سعر لـ ${model.name}`}
    text="أرسل المقاس والدرجة والكمية ووجهة الشحن. نراجع المواصفة ونجهّز لك عرضًا تجاريًا واضحًا."
  />
</Layout>
