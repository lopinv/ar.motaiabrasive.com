---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { resources } from '../../data/site';
---

<Layout
  title="الموارد الفنية وأدلة توريد المواد الكاشطة | موتاى"
  description="أدلة عملية حول اختيار درجات الحبيبات وتجهيز طلبات OEM والتغليف. موارد فنية تساعد مشتري المواد الكاشطة على بناء مواصفة دقيقة قبل طلب التسعير."
  image="/images/grit-reference.png"
>
  <section class="page-hero page-hero--resources">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">مركز الموارد</span>
      <h1>معرفة فنية تساعدك على تجهيز طلب أفضل</h1>
      <p>
        أدلة عملية موجهة لفرق الشراء والمشغلين: معلومات لإعداد المواصفة، مقارنة الخيارات، وشرح
        ما نحتاجه لتحويل الاستفسار إلى عرض واضح.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article class="resource-card">
              <a class="resource-card__media" href={`/resources/${resource.slug}`}>
                <img src={resource.image} alt="" width="520" height="340" loading="lazy" />
                <span>{resource.type}</span>
              </a>
              <div class="resource-card__body">
                <h2><a href={`/resources/${resource.slug}`}>{resource.title}</a></h2>
                <p>{resource.description}</p>
                <ul class="resource-card__topics">
                  {resource.sections.map((section) => <li>{section.title}</li>)}
                </ul>
                <a class="text-link" href={`/resources/${resource.slug}`}>اقرأ الدليل <span>←</span></a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="knowledge-hub">
        <div class="knowledge-hub__intro">
          <span class="eyebrow">مركز المعرفة</span>
          <h2>من المعلومة إلى مواصفة قابلة للشراء</h2>
          <p>
            رتب استفسارك بهذه الطريقة: تعريف المنتج، ثم طريقة التشغيل، ثم الكمية والوجهة.
            بهذه البيانات يكون المقارنة بين العروض أسرع وأوضح.
          </p>
        </div>
        <div class="knowledge-hub__grid">
          <a href="/products/abrasive-belts"><strong>مرجع الأحزمة</strong><span>المقاسات وطرق التثبيت ←</span></a>
          <a href="/products/flap-discs"><strong>مرجع الأقراص</strong><span>الأقطار والقواعد ←</span></a>
          <a href="/industries"><strong>مرجع القطاعات</strong><span>توصيات حسب التطبيق ←</span></a>
          <a href="/quality"><strong>مرجع الفحص</strong><span>نقاط مراجعة الدفعة ←</span></a>
          <a href="/technical-specs"><strong>المواصفات الفنية</strong><span>جداول FEPA والقواعد ←</span></a>
          <a href="/shipping-oem"><strong>التوريد و OEM</strong><span>مراحل الشحن والتغليف ←</span></a>
          <a href="/articles"><strong>المقالات التقنية</strong><span>{`مكتبة المعرفة ←`}</span></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="حوّل الدليل إلى عرض سعر" text="أرسل المواصفة التي جهزتها، وسنراجعها ونرد بتفاصيل مناسبة." />
</Layout>
