---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';

const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);

/** 类别 slug → 阿语标签（展示层映射，数据保持原始 slug） */
const categoryLabels: Record<string, string> = {
  'product-comparison': 'مقارنة منتجات',
  'multi-product-comparison': 'مقارنة متعددة',
  'buying-guide': 'دليل الشراء',
  'technical-guide': 'دليل تقني',
  'application-guide': 'دليل التطبيق',
  'process-tutorial': 'شرح عملية',
  troubleshooting: 'حل المشكلات',
  'product-spec-detail': 'تفاصيل المواصفات',
  'procurement-guide': 'دليل التوريد',
  'wholesale-oem-guide': 'الجملة و OEM',
  'industry-market': 'سوق الصناعة',
  'gcc-regional-sourcing': 'التوريد الخليجي',
  'faq-buyers-guide': 'أسئلة المشترين',
};

/** 产品族 slug → 阿语名（对齐 site.ts productCategories） */
const familyLabels: Record<string, string> = {
  'abrasive-belts': 'أحزمة الصنفرة',
  'flap-discs': 'أقراص الشرائح',
  'sanding-discs': 'أقراص الصنفرة',
  'hook-loop': 'Hook & Loop',
  'sanding-sponges': 'إسفنج الصنفرة',
};

const catLabel = (slug: string) => categoryLabels[slug] ?? slug;
const famLabel = (slug?: string) => (slug ? familyLabels[slug] ?? slug : '');

const categories = [...new Set(articles.map((a) => a.data.category))].sort();

const breadcrumbs = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المقالات التقنية', href: '/articles' },
];

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'المقالات التقنية | موتاى للمواد الكاشطة',
  description:
    'مكتبة مقالات تقنية بالعربية حول اختيار مواد الكشط: مقارنات المنتجات، أدلة الشراء، المواصفات، وأدلة التوريد للخليج.',
  url: `${SITE.url}/articles`,
  inLanguage: 'ar',
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.slice(0, 20).map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/articles/${a.id}`,
      name: a.data.title,
    })),
  },
};
---

<Layout
  title="المقالات التقنية لمواد الكشط | موتاى"
  description="مكتبة مقالات تقنية بالعربية: مقارنات أحزمة وأقراص الكشط، أدلة الشراء والتوريد، المواصفات والدرجات، وحلول مشكلات التشغيل للمشترين الصناعيين في الخليج."
  image="/images/grit-reference.png"
  breadcrumbs={breadcrumbs}
  jsonLd={[collectionJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">مكتبة المعرفة</span>
      <h1>المقالات التقنية لمواد الكشط</h1>
      <p>
        {articles.length} مقالًا تقنيًا يغطي اختيار الدرجات، مقارنات المنتجات، أدلة الشراء
        والتوريد، وحلول مشكلات التشغيل — مكتوبة لمشتري المواد الكاشطة الصناعيين.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="articles-toolbar" data-articles-toolbar>
        <label class="articles-search">
          <span class="sr-only">ابحث في المقالات</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              d="M9 3.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm4 9 4 4"
            ></path>
          </svg>
          <input
            type="search"
            data-articles-search
            placeholder="ابحث بالعنوان أو الكلمات المفتاحية…"
            aria-label="ابحث في المقالات"
          />
        </label>
        <div class="articles-filters" role="group" aria-label="تصفية حسب الفئة">
          <button class="model-filter is-active" data-articles-filter="all" type="button">الكل</button>
          {
            categories.map((cat) => (
              <button class="model-filter" data-articles-filter={cat} type="button">
                {catLabel(cat)}
              </button>
            ))
          }
        </div>
      </div>

      <p class="articles-count" data-articles-count>{articles.length} مقالًا</p>

      <div class="articles-grid" data-articles-grid>
        {
          articles.map((article) => (
            <article class="article-card" data-article-card data-category={article.data.category}>
              <a class="article-card__link" href={`/articles/${article.id}`}>
                <div class="article-card__meta">
                  <span class="article-card__tag">{catLabel(article.data.category)}</span>
                  {article.data.productFamily && (
                    <span class="article-card__fam">{famLabel(article.data.productFamily)}</span>
                  )}
                </div>
                <h2>{article.data.title}</h2>
                <p>{article.data.description}</p>
                <span class="article-card__more">
                  اقرأ المقال
                  <svg aria-hidden="true" viewBox="0 0 20 20" width="14" height="14">
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      d="M11 4l6 6-6 6M4 10h12"
                    ></path>
                  </svg>
                </span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="articles-empty" data-articles-empty hidden>
        لا توجد مقالات مطابقة لبحثك — جرّب كلمة أخرى أو أزل التصفية.
      </p>
    </div>
  </section>

  <CtaBand
    title="لم تجد إجابتك في المقالات؟"
    text="أرسل سؤالك الفني مع مواصفة التشغيل، ونعود إليك بتوصية مناسبة لمادتك وماكينتك."
  />

  <script>
    // قائمة المقالات: بحث فوري + تصفية بالفئة (نفس نمط متصفح الموديلات في /products)
    const toolbar = document.querySelector<HTMLElement>('[data-articles-toolbar]');
    const grid = document.querySelector<HTMLElement>('[data-articles-grid]');
    if (toolbar && grid) {
      const search = toolbar.querySelector<HTMLInputElement>('[data-articles-search]');
      const filters = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-articles-filter]'));
      const count = document.querySelector<HTMLElement>('[data-articles-count]');
      const empty = document.querySelector<HTMLElement>('[data-articles-empty]');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-article-card]'));

      const apply = () => {
        const q = (search?.value || '').trim().toLowerCase();
        const active = filters.find((b) => b.classList.contains('is-active'));
        const cat = active?.dataset.articlesFilter ?? 'all';
        let shown = 0;
        for (const card of cards) {
          const text = (card.textContent || '').toLowerCase();
          const matchCat = cat === 'all' || card.dataset.category === cat;
          const matchQ = !q || text.includes(q);
          const visible = matchCat && matchQ;
          card.hidden = !visible;
          if (visible) shown++;
        }
        if (count) count.textContent = shown + ' مقالًا';
        if (empty) empty.hidden = shown > 0;
      };

      search?.addEventListener('input', apply);
      filters.forEach((btn) =>
        btn.addEventListener('click', () => {
          filters.forEach((b) => b.classList.toggle('is-active', b === btn));
          apply();
        }),
      );
      apply();
    }
  </script>
</Layout>
